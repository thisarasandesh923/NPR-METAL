{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test src/tests/**/*.test.ts",
    "test:unit": "tsx --test src/tests/db-config.test.ts src/tests/auth-unit.test.ts src/tests/money-unit.test.ts src/tests/time-exports-unit.test.ts src/tests/materials-catalog-unit.test.ts src/tests/payroll-cashier-disbursement.test.ts src/tests/payroll-owner-corrections.test.ts src/tests/reports-salary-adjustments-unit.test.ts src/tests/password-reset-hardened.test.ts src/tests/vehicle-pricing-unit.test.ts",
    "test:vehicle-pricing:unit": "tsx --test src/tests/vehicle-pricing-unit.test.ts",
    "test:vehicle-pricing:integration": "tsx --test src/tests/vehicle-pricing-integration.test.ts",
    "test:auth": "tsx --test src/tests/auth.test.ts",
    "test:billing": "tsx --test src/tests/billing.test.ts",
    "test:operations": "tsx --test src/tests/operations-payroll.test.ts",
    "test:db": "tsx --test src/tests/db-integrity.test.ts",
    "test:security": "tsx --test src/tests/db-security-rls.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "diagnose:auth": "tsx src/scripts/diagnose-auth.ts",
    "reset:password": "tsx src/scripts/reset-user-password.ts",
    "db:check": "tsx src/scripts/check-db.ts",
    "migrate:check": "tsx src/scripts/check-migrations.ts",
    "migrate:status": "tsx src/scripts/migration-status.ts",
    "migrate:dry-run": "tsx src/scripts/run-migrations.ts --dry-run",
    "migrate:up": "tsx src/scripts/run-migrations.ts",
    "migrate:create": "node-pg-migrate create -m ../database/migrations -j sql --migration-filename-format index",
    "onboard:users": "tsx src/scripts/onboard-users.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
