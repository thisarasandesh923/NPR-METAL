PORT=4000
# Application runtime database connection (restricted role: npr_app_user.<PROJECT_REF>)
DATABASE_URL=postgresql://npr_app_user.<PROJECT_REF>:<URL_SAFE_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=C:/Users/<YourWindowsUsername>/.postgresql/prod-ca-2021.crt

# Privileged schema migration connection (never used by the Express API server pool)
MIGRATION_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<MIGRATION_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=C:/Users/<YourWindowsUsername>/.postgresql/prod-ca-2021.crt

# Explicit comma-separated allowed browser origins (no wildcard '*')
ALLOWED_ORIGINS=http://localhost:5173

# Session inactivity timeout in minutes (default 30 min; absolute cap 12h)
SESSION_IDLE_TIMEOUT_MINUTES=30